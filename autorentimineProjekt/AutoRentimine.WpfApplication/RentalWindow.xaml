<Window x:Class="AutoRentimine.WpfApplication.RentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аренда автомобиля" Height="500" Width="800">
    <Grid Margin="15">
        <!-- ЭКРАН 1: Выбор машины -->
        <StackPanel x:Name="PanelSelection">
            <TextBlock Text="Выберите автомобиль для аренды" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid x:Name="DgvCars" Height="300" AutoGenerateColumns="True" 
                      SelectionMode="Single" IsReadOnly="True"
                      SelectionChanged="DgvCars_SelectionChanged"/>
            <Button Content="Арендовать выбранный автомобиль" Margin="0,10,0,0"
                    Height="40" FontSize="13" Background="LightGreen"
                    Click="BtnStartRental_Click"/>
        </StackPanel>

        <!-- ЭКРАН 2: Активная поездка -->
        <StackPanel x:Name="PanelActive" Visibility="Collapsed">
            <TextBlock x:Name="LblCarInfo" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock x:Name="LblTimer" Text="Время в пути: 00:00:00" FontSize="13" Margin="0,0,0,5"/>
            <TextBlock x:Name="LblKm" Text="Пройдено: 0.00 км" FontSize="13" Margin="0,0,0,15"/>
            <Button Content="Завершить поездку" Height="40" Width="200" 
                    HorizontalAlignment="Left" Background="Tomato" Foreground="White"
                    FontSize="13" Click="BtnEndRental_Click"/>
        </StackPanel>

        <!-- ЭКРАН 3: Финальный чек -->
        <StackPanel x:Name="PanelResult" Visibility="Collapsed">
            <TextBlock Text="Поездка завершена! К оплате:" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblFinalPrice" FontSize="24" FontWeight="Bold" Foreground="DarkGreen" Margin="0,0,0,10"/>
            <TextBlock x:Name="LblReceiptDetails" FontSize="12" Margin="0,0,0,20"/>
            <Button Content="Вернуться к списку авто" Height="40" Width="220"
                    HorizontalAlignment="Left" FontSize="12"
                    Click="BtnBackToMenu_Click"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="AutoRentimine.WpfApplication.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление авто" Height="500" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DataGrid ItemsSource="{Binding Data}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto"/>
                <DataGridTextColumn Header="Марка" Binding="{Binding Mark}" Width="*"/>
                <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="*"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding RegistrationNumber}" Width="*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding DailyRate}" Width="*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Марка:"/>
            <TextBox Text="{Binding Mark, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Label Content="Модель:"/>
            <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Label Content="Номер:"/>
            <TextBox Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Label Content="Цена:"/>
            <TextBox Text="{Binding DailyRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <Label Content="Статус:"/>
            <TextBox Text="{Binding Status, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <UniformGrid Columns="2" Rows="2">
                <Button Content="🚗 Аренда" Command="{Binding OpenRentalCommand}" 
        Width="100" Height="30" Margin="5,0,0,0" Background="LightGreen"/>
                <Button Content="Добавить" Command="{Binding AddCommand}"/>
                <Button Content="Сохранить (Очистить)" Command="{Binding SaveCommand}"/>
                <Button Content="Удалить" Command="{Binding DeleteCommand}"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>